# Domínio público da API (aponte o DNS para a VPS antes de subir o Caddy)
CONEXAO_DOMAIN=api.conexao.gg
# Site público com a página de download (apex do domínio; www redireciona para ele)
CONEXAO_SITE_DOMAIN=conexao.gg
# Páginas públicas de perfil (perfil.<domínio>/u/<nick>)
CONEXAO_PROFILE_DOMAIN=perfil.conexao.gg
# Domínio do painel web dos administradores
CONEXAO_PANEL_DOMAIN=painel.conexao.gg
# Passe de entrada das contas não originais: SÓ registro A (sem AAAA) e sem proxy da Cloudflare
CONEXAO_JOIN_DOMAIN=join.conexao.gg
POSTGRES_PASSWORD=troque-esta-senha
# Gere com: openssl rand -hex 32
CONEXAO_JWT_SECRET=
# Token da equipe Conexão para aprovar servidores e vender destaque (openssl rand -hex 24)
CONEXAO_STAFF_TOKEN=
# Origens do painel web, separadas por vírgula (vazio = qualquer)
CONEXAO_CORS_ORIGINS=https://painel.conexao.gg
# Chave que assina os manifestos: rode `conexao-api gerar-chave-assinatura`.
# A chave pública (CONEXAO_MANIFEST_PUBKEY) vai no build do launcher.
CONEXAO_SIGNING_KEY=
# UUIDs Minecraft (com ou sem hífens) da equipe Conexão, separados por vírgula
CONEXAO_STAFF_UUIDS=
# Espaço por servidor para arquivos que não estão no Modrinth (configs, mods próprios), em MB
CONEXAO_SERVER_QUOTA_MB=300
# Cota dos servidores em destaque (plano pago), em MB
CONEXAO_FEATURED_QUOTA_MB=1024

# ---- Perfis
# Itens premium (molduras animadas, fontes e efeitos extras) só para quem tem Conexão+.
# false = tudo liberado para todos (lançamento).
CONEXAO_PREMIUM_ENFORCED=false
# Quem criar o perfil até esta data ganha o selo "Pioneiro" (ISO 8601, vazio = sem selo)
CONEXAO_PIONEER_UNTIL=
# Arquivo opcional com palavras bloqueadas extras nos perfis (uma por linha)
CONEXAO_BLOCKED_WORDS_FILE=

# ---- Contas não originais (docs/contas-nao-originais.md)
# App do Discord (discord.com/developers → Applications → OAuth2). Redirect a cadastrar lá:
# https://<CONEXAO_DOMAIN>/v1/auth/discord/callback
# Vazio = botão "Jogar sem conta original" desativado.
CONEXAO_DISCORD_CLIENT_ID=
CONEXAO_DISCORD_CLIENT_SECRET=

# ---- Destaque pago (Mercado Pago, Checkout Pro)
# Access token da aplicação (Mercado Pago Developers → Suas integrações → Credenciais).
#  - Teste: o token APP_USR-… da conta de teste VENDEDORA; pague com a conta de teste COMPRADORA
#    ou com os cartões de teste (titular APRO = aprovado, OTHE = recusado; CPF 12345678909).
#  - Produção: o access token de produção do app "centrallauncher" na sua conta real.
# Vazio = pagamentos desligados (o painel avisa).
CONEXAO_MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações → Webhooks). URL a configurar lá:
# https://<CONEXAO_DOMAIN>/v1/payments/mercadopago/webhook  (evento: Pagamentos)
CONEXAO_MP_WEBHOOK_SECRET=
# Planos: dias:preço em reais, separados por vírgula
CONEXAO_FEATURED_PLANS=7:29.90,15:49.90,30:89.90

# ---- Limites e segurança
# Com CONEXAO_DOMAIN em https a API entra em modo produção e NÃO sobe sem
# CONEXAO_SIGNING_KEY, CONEXAO_CORS_ORIGINS e (com pagamentos) CONEXAO_MP_WEBHOOK_SECRET.
# Tamanho máximo de cada arquivo enviado (MB). Cada conta também tem uma cota diária
# igual à cota do servidor (CONEXAO_SERVER_QUOTA_MB / CONEXAO_FEATURED_QUOTA_MB).
CONEXAO_MAX_UPLOAD_MB=100
# Quantos servidores em análise (ou recusados) uma conta pode ter ao mesmo tempo
CONEXAO_MAX_PENDING_SERVERS=3

# ---- Backup (serviço "backup" do docker-compose; veja docs/backup.md)
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=6
# Cópia externa com rclone (docker compose --profile offsite up -d)
RCLONE_REMOTE=backup:nome-do-bucket

# ---- Monitoramento (docs/monitoramento.md)
# Webhook do Discord para avisos de disco cheio e backup atrasado (vazio = só no log)
CONEXAO_ALERT_WEBHOOK=
# % do disco em uso: aviso no Discord / /health responde 503 (UptimeRobot avisa)
CONEXAO_DISK_WARN_PERCENT=85
CONEXAO_DISK_ALERT_PERCENT=90
