# syntax=docker/dockerfile:1
# Imagem da API central do Conexão
FROM rust:1.95-slim-bookworm AS build
WORKDIR /src
COPY . .
# Cache do cargo entre builds (BuildKit): só recompila o que mudou.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p conexao-api && cp target/release/conexao-api /conexao-api

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --from=build /conexao-api /usr/local/bin/conexao-api
ENV CONEXAO_BIND=0.0.0.0:8080 CONEXAO_STORAGE_DIR=/data
VOLUME /data
EXPOSE 8080
CMD ["conexao-api"]
