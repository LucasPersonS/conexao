# Cabeçalhos de segurança comuns a todos os domínios.
(seguranca) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}

# Conteúdo enviado por usuários: nunca é executado nem aberto como página no nosso domínio.
(arquivo_inerte) {
	header Content-Security-Policy "default-src 'none'; sandbox"
	header X-Frame-Options "DENY"
}

{$CONEXAO_DOMAIN} {
	encode zstd gzip
	import seguranca

	# Arquivos dos modpacks servidos direto do disco, com cache longo
	# (o nome é o SHA-1, então o conteúdo nunca muda). Sempre como download binário:
	# um HTML enviado como "mod" não abre como página no domínio da API.
	handle /files/* {
		root * /srv/conexao
		import arquivo_inerte
		header Cache-Control "public, max-age=31536000, immutable"
		header >Content-Type "application/octet-stream"
		header Content-Disposition "attachment"
		file_server
	}

	# Ícones e banners enviados pelo painel (nome = SHA-1, nunca muda; a API regrava a imagem)
	handle /images/* {
		root * /srv/conexao
		import arquivo_inerte
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Atualização automática do launcher (latest.json + instaladores)
	handle /launcher/* {
		root * /srv/conexao
		import arquivo_inerte
		header /launcher/latest.json Cache-Control "no-cache"
		# Mesmo nome a cada versão: o navegador sempre confere se mudou.
		header /launcher/Conexao-Instalador.exe Cache-Control "no-cache"
		file_server
	}

	# Perfis mudaram para o domínio próprio: links antigos continuam funcionando.
	redir /u/* https://{$CONEXAO_PROFILE_DOMAIN}{uri} permanent

	handle {
		header X-Frame-Options "DENY"
		reverse_proxy api:8080
	}
}

# Páginas públicas de perfil: perfil.<domínio>/u/<nick> (geradas pela API).
{$CONEXAO_PROFILE_DOMAIN} {
	encode zstd gzip
	import seguranca
	header X-Frame-Options "DENY"

	handle /u/* {
		reverse_proxy api:8080
	}
	# Rodapé do perfil ("Baixe o Conexão") e qualquer outro caminho levam ao site.
	handle /baixar {
		redir https://{$CONEXAO_DOMAIN}{uri} 302
	}
	handle {
		redir https://{$CONEXAO_SITE_DOMAIN}/ 302
	}
}

# Passe de entrada das contas não originais. Só registro A no DNS (sem AAAA, sem proxy da
# Cloudflare): o launcher pede o passe por aqui para a API ver o mesmo IPv4 com que o jogo conecta.
{$CONEXAO_JOIN_DOMAIN} {
	import seguranca
	@passe path_regexp ^/v1/servers/[a-z0-9-]+/join-ticket$
	handle @passe {
		reverse_proxy api:8080
	}
	handle {
		respond 404
	}
}

# Site público (landing page do instalador): apps/site, HTML estático, sem build.
{$CONEXAO_SITE_DOMAIN} {
	encode zstd gzip
	import seguranca
	header {
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://cdn.discordapp.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
	}

	# Lista de espera: login pelo Discord e situação da fila, com cookie só deste domínio.
	handle /v1/waitlist/* {
		reverse_proxy api:8080
	}

	# conexaosmps.com.br/baixar -> o /baixar da API, passando aqui mesmo para ela ver o cookie
	# da lista: quem foi liberado recebe o instalador; quem não foi volta para a lista.
	handle /baixar {
		reverse_proxy api:8080
	}

	# latest.json e instaladores no mesmo domínio: o site mostra versão e tamanho sem CORS.
	handle /launcher/* {
		root * /srv/conexao
		import arquivo_inerte
		header /launcher/latest.json Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /srv/site
		header /assets/* Cache-Control "public, max-age=86400"
		try_files {path} {path}.html
		file_server
	}

	handle_errors 404 {
		root * /srv/site
		rewrite * /404.html
		file_server
	}
}

# www -> domínio principal
www.{$CONEXAO_SITE_DOMAIN} {
	import seguranca
	redir https://{$CONEXAO_SITE_DOMAIN}{uri} permanent
}

# Painel web (build estático de apps/panel: npm run build)
{$CONEXAO_PANEL_DOMAIN} {
	encode zstd gzip
	import seguranca
	header {
		X-Frame-Options "DENY"
		# Só scripts do próprio painel; fontes do Google para o card de perfil; a API no domínio dela.
		Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://{$CONEXAO_DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	root * /srv/panel
	file_server
}
