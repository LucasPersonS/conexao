{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conexao",
  "mainBinaryName": "conexao",
  "version": "0.1.3",
  "identifier": "gg.conexao.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Conexão",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: http://localhost:* http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["conexao"] }
    }
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Launcher de Minecraft Roleplay",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
